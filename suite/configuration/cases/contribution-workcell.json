              "type": "enum",
              "options": [
                {
                  "value": "off",
                  "title": "Off — everything local"
                },
                {
                  "value": "hosted-vm",
                  "title": "Hosted VM"
                },
                {
                  "value": "dedicated-host",
                  "title": "Dedicated host"
                }
              ]
            },
            "allowed_scopes": [
              {
                "scope_kind": "world",
                "scope_ref": null
              },
              {
                "scope_kind": "machine",
                "scope_ref": null
              }
