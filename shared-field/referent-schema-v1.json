{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o-i.dev/schemas/referent-schema-v1.json",
  "title": "O:I Common Referent and Reconciliation Contracts v1",
  "description": "A stable referential pole over attributable plural forms. CommonReferent is not a source object, file/blob, representation, source revision, Projection, Participant, ownership, licence, authority, WikiNode, Source or KnowledgeRoute.",
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "required": ["ref", "kind"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "kind": { "$ref": "#/$defs/ref" },
        "revision": { "$ref": "#/$defs/ref" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "strength"],
      "properties": {
        "kind": { "$ref": "#/$defs/ref" },
        "strength": { "enum": ["strong", "weak"] }
      },
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "required": ["schema", "binding_ref", "referent_ref", "subject", "relation_kind", "evidence", "asserted_by", "mediation", "state"],
      "properties": {
        "schema": { "const": "oi.referent-binding/v1" },
        "binding_ref": { "$ref": "#/$defs/ref" },
        "referent_ref": { "type": "string", "pattern": "^oi:referent:" },
        "subject": { "$ref": "#/$defs/subject" },
        "relation_kind": {
          "enum": ["same-representation", "same-resource", "same-referent", "version-of", "variant-form-of", "translation-of", "derived-from"]
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "asserted_by": { "type": "object" },
        "mediation": { "type": "object" },
        "state": { "enum": ["accepted", "proposed", "disputed"] },
        "created_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "commonReferent": {
      "type": "object",
      "required": ["schema", "referent_ref", "display_heading", "display_mediation"],
      "properties": {
        "schema": { "const": "oi.common-referent/v1" },
        "referent_ref": { "type": "string", "pattern": "^oi:referent:" },
        "display_heading": { "$ref": "#/$defs/ref" },
        "representative_ref": { "$ref": "#/$defs/ref" },
        "display_mediation": { "$ref": "#/$defs/ref" }
      },
      "additionalProperties": true
    },
    "resolution": {
      "type": "object",
      "required": ["schema", "referent_ref", "constraints", "load"],
      "properties": {
        "schema": { "const": "oi.referent-resolution/v1" },
        "referent_ref": { "type": "string", "pattern": "^oi:referent:" },
        "constraints": { "type": "object" },
        "load": { "enum": ["none", "selected-only"] }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/commonReferent" },
    { "$ref": "#/$defs/binding" },
    { "$ref": "#/$defs/resolution" }
  ]
}
