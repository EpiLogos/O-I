{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o-i.dev/schemas/explore-v1.json",
  "title": "O:I Explore v1 cross-client read models",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "ref", "source_system"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "source_system": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["surface", "locator"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ref", "kind", "world_ref", "label", "aliases", "provenance", "locators"],
      "properties": {
        "schema": {"const": "oi.explore-entry/v1"},
        "ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "world_ref": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "projection_ref": {"type": "string", "minLength": 1},
        "meta": {"type": "object"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation", "origin", "provenance"],
      "properties": {
        "relation_ref": {"type": "string", "minLength": 1, "description": "Optional exact semantic relation ref disclosed by its owner; never a transport row ID."},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "presentationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "expressions", "world_presentations", "projections", "field_occurrences"],
      "description": "The compact per-result reveal: eligible presentation forms of the subject, each category a distinct kind of ref.",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "presentation_ref"],
            "properties": {
              "role": {"enum": ["being", "thing"]},
              "presentation_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "expressions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "world_presentations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "projections": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "field_occurrences": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "subjectPresentations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "subject_ref", "roles", "expressions", "world_presentations", "projections", "field_occurrences"],
      "description": "The full presentation reading of one native subject. subject != presentation != Projection != live SharedField occurrence; never one aggregate.",
      "properties": {
        "schema": {"const": "oi.subject-presentations/v1"},
        "subject_ref": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "presentation_ref"],
            "properties": {
              "role": {"enum": ["being", "thing"]},
              "presentation_ref": {"type": "string", "minLength": 1},
              "expression_ref": {"type": "string", "minLength": 1},
              "projection_ref": {"type": "string", "minLength": 1},
              "projection_revision": {"type": "integer", "minimum": 1}
            }
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression_ref", "expression_revision", "presentation_ref", "subjects_available"],
            "properties": {
              "expression_ref": {"type": "string", "minLength": 1},
              "expression_revision": {"type": "integer", "minimum": 1},
              "presentation_ref": {"type": "string", "minLength": 1},
              "projection_ref": {"type": "string", "minLength": 1},
              "projection_revision": {"type": "integer", "minimum": 1},
              "live_renderer_ref": {"type": "string", "minLength": 1},
              "subjects_available": {"type": "boolean"}
            }
          }
        },
        "world_presentations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "projections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projection_ref", "projection_revision", "state", "subject"],
            "properties": {
              "projection_ref": {"type": "string", "minLength": 1},
              "projection_revision": {"type": "integer", "minimum": 1},
              "state": {"type": "string", "minLength": 1},
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref"],
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "ref": {"type": "string", "minLength": 1}
                }
              },
              "source_revision": {"type": "string", "minLength": 1}
            }
          }
        },
        "field_occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_ref", "via"],
            "properties": {
              "field_ref": {"type": "string", "minLength": 1},
              "via": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "discoveryView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generated_from", "revision", "entries", "relations", "presentations"],
      "description": "The bounded, rebuildable discovery export of one Explore read model: stable refs, aliases, typed relations, structured presentation bindings, Projection identity and SharedField membership. Payloads excluded; another World or AIKit Search/Resolve resolves the same semantic refs from it.",
      "properties": {
        "schema": {"const": "oi.explore-discovery/v1"},
        "generated_from": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "presentations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["presentation_ref", "kind", "world_ref", "subjects"],
            "properties": {
              "presentation_ref": {"type": "string", "minLength": 1},
              "revision": {"type": "integer", "minimum": 1},
              "kind": {"type": "string", "minLength": 1},
              "world_ref": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "projection_ref": {"type": "string", "minLength": 1},
              "projection_revision": {"type": "integer", "minimum": 1},
              "projection_state": {"type": "string", "minLength": 1},
              "subjects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ref"],
                  "properties": {
                    "ref": {"type": "string", "minLength": 1},
                    "role": {"enum": ["being", "thing"]},
                    "availability": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_fields", "relation_fields"],
          "properties": {
            "entry_fields": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
            "relation_fields": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_ref"],
            "properties": {
              "field_ref": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "visibility": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ref", "kind", "world_ref", "label", "provenance", "locators", "score"],
      "properties": {
        "schema": {"const": "oi.explore-result/v1"},
        "ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "world_ref": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "projection_ref": {"type": "string", "minLength": 1},
        "field_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "presentations": {"$ref": "#/$defs/presentationSummary"},
        "score": {"type": "number", "minimum": 0}
      }
    },
    "relationView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "focus", "depth", "budget", "nodes", "edges", "truncated"],
      "properties": {
        "schema": {"const": "oi.explore-relation-view/v1"},
        "focus": {"type": "string", "minLength": 1},
        "depth": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 1},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "truncated": {"type": "boolean"}
      }
    },
    "sourceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "provenance"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "explainView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "world_ref", "semantic_identity", "provenance", "transport_locators"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "world_ref": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "semantic_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "kind", "world_ref"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "minLength": 1},
            "world_ref": {"type": "string", "minLength": 1}
          }
        },
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "transport_locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "projection_ref": {"type": "string", "minLength": 1}
      }
    },
    "openView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "relations", "actions"],
      "properties": {
        "resource": {"$ref": "#/$defs/entry"},
        "relations": {"$ref": "#/$defs/relationView"},
        "field_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "presentations": {"$ref": "#/$defs/subjectPresentations"},
        "actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "surfaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "read_model"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "read_model": {"$ref": "#/$defs/openView"}
      }
    }
  },
  "properties": {
    "entry": {"$ref": "#/$defs/entry"},
    "search_result": {"$ref": "#/$defs/searchResult"},
    "relation_view": {"$ref": "#/$defs/relationView"},
    "source_view": {"$ref": "#/$defs/sourceView"},
    "explain_view": {"$ref": "#/$defs/explainView"},
    "open_view": {"$ref": "#/$defs/openView"},
    "surface_view": {"$ref": "#/$defs/surfaceView"},
    "subject_presentations": {"$ref": "#/$defs/subjectPresentations"},
    "discovery_view": {"$ref": "#/$defs/discoveryView"}
  }
}
