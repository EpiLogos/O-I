{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@research-canvas/schema": ["./expressions-app/vendor/research-canvas/packages/schema/src/index.ts"],
      "@research-canvas/domain": ["./expressions-app/vendor/research-canvas/packages/domain/src/index.ts"],
      "@research-canvas/desktop-api": ["./expressions-app/vendor/research-canvas/packages/desktop-api/src/index.ts"]
    }
  },
  "include": ["src"]
}
