import {chromium} from "playwright";
const browser = await chromium.launch({headless: true});
const page = await browser.newPage({viewport: {width: 1422, height: 858}, reducedMotion: "reduce"});
const errors = [];
page.on("pageerror", e => errors.push(String(e)));
await page.addInitScript(() => {
  window.__OI_KERNEL_BRIDGE__ = "http://127.0.0.1:4182";
  sessionStorage.setItem("oi-cradle.welcome.v1", "1");
});
await page.goto("http://localhost:1421");
await page.waitForTimeout(2500);
// Select the O-I project in the navigator's project control.
const projectSelect = page.getByLabel("Project", {exact: true});
if (await projectSelect.count()) await projectSelect.selectOption({label: "O-I"}).catch(e => console.log("select:", String(e).slice(0, 80)));
await page.waitForTimeout(1200);
await page.keyboard.press("Alt+Meta+2");
await page.waitForTimeout(2000);
await page.screenshot({path: "/tmp/f1-factory-panel-open.png"});
await page.getByRole("button", {name: "Toggle right region"}).click();
await page.waitForTimeout(900);
await page.screenshot({path: "/tmp/f2-factory-panel-closed.png"});
await page.getByRole("button", {name: "Toggle right region"}).click();
await page.waitForTimeout(900);
await page.screenshot({path: "/tmp/f3-factory-panel-reopened.png"});
console.log("ERRORS:", JSON.stringify(errors.slice(0,3)));
await browser.close();
