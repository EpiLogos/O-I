{
  "schema": "ql.nara-deixis/v1",
  "purpose": "Deixis round trip over exact refs: pointer/selection arrives mapped, Nara's spoken reference resolves against its bounded context only, and nothing outside the context is invented.",
  "requests": [
    {
      "request": {
        "schema": "ql.nara-deixis/v1",
        "deixis_ref": "deixis:fixture-1",
        "nara_ref": "nara:fixture-a",
        "turn_ref": "turn:fixture-1",
        "basis_expression_revision": "rev-7",
        "kind": "pointed",
        "target": {
          "target": "exact",
          "ref_id": "bimba:relation:1",
          "target_kind": "relation"
        },
        "requested_at_unix_ms": 10
      },
      "expected": {
        "outcome": "focused",
        "focus_refs": ["bimba:relation:1"],
        "turn_refs_contain": "bimba:relation:1",
        "expression_revision": "rev-7"
      }
    },
    {
      "request": {
        "schema": "ql.nara-deixis/v1",
        "deixis_ref": "deixis:fixture-2",
        "nara_ref": "nara:fixture-a",
        "turn_ref": "turn:fixture-1",
        "basis_expression_revision": "rev-7",
        "kind": "pointed",
        "target": {
          "target": "exact",
          "ref_id": "source:fixture-undisclosed",
          "target_kind": "source"
        },
        "requested_at_unix_ms": 11
      },
      "expected": {
        "outcome": "unresolved-outside-context",
        "ref_id": "source:fixture-undisclosed"
      }
    },
    {
      "request": {
        "schema": "ql.nara-deixis/v1",
        "deixis_ref": "deixis:fixture-3",
        "nara_ref": "nara:fixture-a",
        "turn_ref": "turn:fixture-1",
        "basis_expression_revision": "rev-7",
        "kind": "spoken",
        "target": {
          "target": "spoken",
          "phrase": "that source you disclosed",
          "candidate_refs": ["source:fixture-disclosed-1"]
        },
        "requested_at_unix_ms": 12
      },
      "expected": {
        "outcome": "focused",
        "focus_refs": ["source:fixture-disclosed-1"],
        "turn_refs_contain": "source:fixture-disclosed-1",
        "expression_revision": "rev-7"
      }
    },
    {
      "request": {
        "schema": "ql.nara-deixis/v1",
        "deixis_ref": "deixis:fixture-4",
        "nara_ref": "nara:fixture-a",
        "turn_ref": "turn:fixture-1",
        "basis_expression_revision": "rev-6",
        "kind": "pointed",
        "target": {
          "target": "exact",
          "ref_id": "bimba:relation:1",
          "target_kind": "relation"
        },
        "requested_at_unix_ms": 13
      },
      "expected": {
        "outcome": "error",
        "error_contains": "deixis request is stale"
      }
    }
  ]
}
