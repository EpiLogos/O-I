{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Bundled shell webviews only. Other webviews receive no native capabilities; application commands are explicitly scoped.",
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-choose-central-folder",
    "allow-arrangement-menu",
    "allow-kernel-op",
    "allow-kernel-event-log",
    "allow-window-detach",
    "allow-window-binding",
    "allow-window-redock",
    "allow-window-focus-subject",
    "allow-window-focus-main",
    "allow-browser-attach",
    "allow-browser-control",
    "allow-browser-reconcile"
  ],
  "webviews": [
    "main",
    "surface-*"
  ]
}
