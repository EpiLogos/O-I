{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "O-I",
  "version": "0.1.0",
  "identifier": "org.epilogos.oi.cradle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "O-I",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": {
        "default-src": "'self' customprotocol: oi-material:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' oi-material: data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'sha256-nUug3uH8Wg2Ec27Vn6CJHqHSoYlW8W0zfhIAcxC0yHg='",
        "object-src": "'none'",
        "frame-src": "oi-material:",
        "base-uri": "'none'"
      }
    }
  }
}
