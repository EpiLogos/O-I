{
  "name": "oi-cradle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1421",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "walk": "node walk/run.mjs",
    "lint:receipts": "node scripts/receipt-lint.mjs",
    "coverage": "cd ../.. && python3 scripts/experience_map.py --coverage-out docs/experience/coverage-reading",
    "build:expressions": "node scripts/ensure-expressions-app.mjs && npm --prefix expressions-app run build",
    "predev": "npm run build:expressions && node documents/build-personal.mjs",
    "prebuild": "npm run build:expressions && node documents/build-personal.mjs",
    "test:personal-web": "node documents/build-personal.mjs && node --test tests/personal-web.test.mjs && node tests/personal-web-browser.mjs",
    "test:configuration-live": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/configuration-live-source.test.mjs",
    "test:configuration-composition": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/configuration-composition.test.mjs",
    "test:canvas-editor": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/canvas-editor-contract.test.mjs tests/material-html-lifecycle.test.mjs && node tests/canvas-editor-browser.mjs",
    "test:chat-settings-live": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/chat-settings.live.mjs",
    "test:situation": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/situation-frame.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@epilogos/oi-design-system": "file:../../packages/oi-design-system",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "hash-wasm": "^4.12.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
