   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "S1 · ARGUED · M38",
     "title": "S1 — Actuation: living articulation",
     "italic": "MEF pair L1 Causal × L4′ Scientific · movement M38 · parent S",
     "body": "",
     "x": 0.033,
     "y": 0.04,
     "width": 440,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "Actuation is the living articulation of an internality: its event-substance. A life perceives, differentiates, imagines, speaks and acts; through these events its world takes on a particular form and its later possibilities change. An act is intelligible through what occasions it, what it works upon, how it takes form, what it is for and what it changes.",
     "x": 0.57,
     "y": 0.06,
     "width": 430,
     "size": 14,
     "align": "left"
    },
    {
     "id": "lens1",
     "visible": true,
     "kicker": "L1 Causal",
     "title": "",
     "italic": "",
     "body": "Svātantrya is the originating freedom through which articulation is possible. Material is that upon which the present determination works. Efficient is the activity effecting the change. Formal is the organisation by which this becomes this act rather than another. Final is its end or containing purpose. Will gathers the determination into a committed movement and returns its consequence to the possibility of further articulation.",
     "x": 0.033,
     "y": 0.57,
     "width": 390,
     "size": 14,
     "align": "left"
    },
    {
     "id": "lens2",
     "visible": true,
     "kicker": "L4′ Scientific",
     "title": "",
     "italic": "",
     "body": "Prompt occasions a directed act. Traces retain what actually happened and under which conditions. Challenges bring contrary evidence, resistance and excluded alternatives into the inquiry. Patterns disclose relations across those traces and differences. Discovery changes what the inquiry knows or can do. Insight integrates that change into the understanding from which another act begins.",
     "x": 0.51,
     "y": 0.57,
     "width": 400,
     "size": 14,
     "align": "left"
    }
   ],
