    {
     "id": "editorial",
     "visible": true,
     "kicker": "S · ARGUED · product-field",
     "title": "S — World and Life",
     "italic": "Members S0–S5 · Arguments A26 A26′ A27 A27′ A29 A29′ A30 A30′ A35 · Concepts C14 C41 C42 C45 C51 C56 C64",
     "body": "",
