   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "S5 · ARGUED · M42",
     "title": "S5 — Quaternal Logic: Transcendent Relation",
     "italic": "MEF pair L5 Para Vāk × L0′ Archetypal-Numerical · movement M42 · parent S",
     "body": "",
     "x": 0.033,
     "y": 0.04,
     "width": 440,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "Quaternal Logic is Transcendent Relation: the movement through which a whole differentiates without ceasing to be whole, and through which differentiated beings remain related to the larger fields in which their distinctions arise. Transcendence here does not require a final exterior standing over the relation.",
     "x": 0.57,
     "y": 0.06,
     "width": 430,
     "size": 14,
     "align": "left"
    },
    {
     "id": "lens1",
     "visible": true,
     "kicker": "L5 Para Vāk: articulation from the unconditioned toward manifest distinction",
     "title": "",
     "italic": "",
     "body": "Anuttara/Asambhava · Para Vāk · Paśyantī · Madhyamā · Vaikharī · Mātṛkā: from what is prior to determinate articulation, through undivided word/power, vision, interior differentiation and expressed articulation, to the matrix through which signs proliferate. A spoken word is not the beginning of differentiation but a late explicit form of the movement by which a field takes form as distinction.",
     "x": 0.033,
     "y": 0.57,
     "width": 390,
     "size": 14,
     "align": "left"
    },
    {
     "id": "lens2",
     "visible": true,
     "kicker": "L0′ Archetypal-Numerical: one becomes articulated whole",
     "title": "",
     "italic": "",
     "body": "Unity is undivided holding. Duality differentiates poles. Triad introduces mediation by which difference becomes intelligible. Quaternity stabilises a structured field. Pentad develops a further relational determination or centre of transformation. Hexad articulates a whole capable of recursive return: the two singles {0,1} and their four pairings give 2 + 2² = 4 + 2 = 6.",
     "x": 0.51,
     "y": 0.57,
     "width": 400,
     "size": 14,
     "align": "left"
    }
   ],
   "composition": {
