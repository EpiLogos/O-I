   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "dossier-bohm · ARGUED",
     "title": "Bohm — Enfoldment, Dialogue and the Return of an Account",
     "italic": "Paraphrased primary carriers; Argued native coordination; Offered technical practice",
     "body": "",
     "x": 0.033,
     "y": 0.05,
     "width": 470,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "An account determines something through a field it cannot replace. E4's Symbol, Account and Trust whole grounds this dossier's question: how does a useful explication retain the activity, source and relation through which it became articulate? Symbol answers to source; Account does not replace source; Trust keeps the return route active; Account re-enters source-field. The fourth operation sends this inquiry into Bohm's work.",
     "x": 0.033,
     "y": 0.44,
     "width": 620,
     "size": 15,
     "align": "left"
    }
