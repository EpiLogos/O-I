   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "dossier-formal-limit · ARGUED; SPECIFIED FORMAL CONSEQUENCES DERIVED UNDER THEIR STATED ASSUMPTIONS",
     "title": "Formal Limit — Source-Specific Limits and Their Consequences",
     "italic": "Paraphrased source-specific accounts; Argued from native derivation; comparative extensions explicitly distinguished",
     "body": "",
     "x": 0.033,
     "y": 0.05,
     "width": 470,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "A03, Immutable Gap / Formal Limit grounds the native pressure. Including the conditions of an account produces a further account whose present occurrence has conditions. Successful reflection therefore makes something newly explicit while renewing the difference between its content and its act. C04, Formal Limit defines an operation's constraint under specified conditions; C05, Immutable Gap defines that recurrent non-coincidence.",
     "x": 0.033,
     "y": 0.44,
     "width": 620,
     "size": 15,
     "align": "left"
    }
   ],
