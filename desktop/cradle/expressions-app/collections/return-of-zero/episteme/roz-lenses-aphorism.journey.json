   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "lens-baudrillard · ARGUED",
     "title": "Baudrillard — Simulation and the Account’s Return",
     "italic": "Paraphrased selected Baudrillard passages; Argued from native account/source relations; Offered comparative extensions",
     "body": "",
     "x": 0.033,
     "y": 0.05,
     "width": 470,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "An account can change the conditions under which its next statement becomes credible. A profile affects access; access changes conduct; recorded conduct appears to confirm the profile. The profile has acted within its object’s world. Whether it describes that world faithfully remains a further question.",
