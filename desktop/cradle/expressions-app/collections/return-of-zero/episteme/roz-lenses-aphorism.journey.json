   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "aphorism-investigation-and-faith · ARGUED",
     "title": "Investigation and Faith",
     "italic": "Returns through A03 to C04 / C48 · carried by the Symbol / Account / Trust whole-field",
     "body": "",
     "x": 0.033,
     "y": 0.05,
     "width": 470,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "“The approachable limit is the basis of investigation; the absolute limit is the basis of faith; the limit of investigation is the limit of determination; the limit of faith is never to be determined.”\n\nInvestigation approaches something that can become more determinate. An omitted observation can be made, a claim examined, an instrument's conditions exposed, a frame revised. The resulting knowledge changes what can next be asked and done. Approach names this positive capacity to enter a question and make a difference within it.",
     "x": 0.033,
     "y": 0.4,
     "width": 620,
     "size": 15,
     "align": "left"
    }
