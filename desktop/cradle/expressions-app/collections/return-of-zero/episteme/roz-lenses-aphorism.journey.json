   "text": [
    {
     "id": "editorial",
     "visible": true,
     "kicker": "lens-foucault · ARGUED",
     "title": "Foucault — Knowledge, Power, and the Authority to Return",
     "italic": "Argued from",
     "body": "",
     "x": 0.033,
     "y": 0.05,
     "width": 470,
     "size": 25,
     "align": "left"
    },
    {
     "id": "body",
     "visible": true,
     "kicker": "",
     "title": "",
     "italic": "",
     "body": "An account exercises authority when it helps determine what can appear as a case, who can speak about it, and what can be done to the person it describes. This lens follows that operation in the episteme register. Its aperture is the encounter between a practice of knowing and the relations that make its objects actionable. Its question reaches beyond the accuracy of a completed description to the authority acquired through describing.",
     "x": 0.033,
     "y": 0.44,
     "width": 620,
     "size": 15,
     "align": "left"
    }
