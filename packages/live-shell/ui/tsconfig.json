{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@research-canvas/schema": [
        "../../../desktop/cradle/expressions-app/vendor/research-canvas/packages/schema/src/index.ts"
      ],
      "@research-canvas/desktop-api": [
        "../../../desktop/cradle/expressions-app/vendor/research-canvas/packages/desktop-api/src/index.ts"
      ],
      "@research-canvas/domain": [
        "../../../desktop/cradle/expressions-app/vendor/research-canvas/packages/domain/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../../desktop/cradle/src/**/*.d.ts"
  ]
}
