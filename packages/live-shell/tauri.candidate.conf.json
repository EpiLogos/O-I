{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "O-I Shell Candidate",
  "identifier": "org.epilogos.oi.live-shell",
  "build": {
    "beforeBuildCommand": "",
    "devUrl": null
  },
  "bundle": {
    "targets": [
      "app"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "O-I Shell Candidate",
        "url": "app/index.html",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "capabilities": [
        "main-window",
        "native-shell"
      ],
      "csp": {
        "frame-src": "'self' oi-material:"
      }
    }
  }
}
