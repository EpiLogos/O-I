{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epilogos.github.io/o-i/schemas/oi.config-changeset-v1.schema.json",
  "title": "O:I Config ChangeSet v1",
  "description": "A stable, machine-readable change plan over one or more owner-native operations. Not a distributed transaction: per-operation truth, derived overall status, no implicit rollback. Frozen by docs/cradle/09-CONFIGURATION-PLANE.md §8 (#299 C0-7).",
  "type": "object",
  "required": ["schema", "changeset_id", "created_at_unix_ms", "requested", "operations", "status"],
  "properties": {
    "schema": { "const": "oi.config-changeset/v1" },
    "changeset_id": { "description": "client-minted `cs-` + unique suffix", "type": "string", "pattern": "^cs-[A-Za-z0-9_-]+$" },
    "created_at_unix_ms": { "type": "integer", "minimum": 0 },
    "profile_ref": { "type": ["string", "null"] },
    "requested": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requestedChange" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "verification": { "$ref": "#/$defs/verification" },
    "status": {
      "enum": ["planned", "validated", "applied", "verified", "partially_applied", "failed"],
      "description": "Derived from per-operation statuses, never asserted (09 §8)."
    },
    "authority": {
      "type": "object",
      "properties": {
        "requires": { "type": "array", "items": { "type": "string" } },
        "granted_by": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "requestedChange": {
      "type": "object",
      "required": ["setting_ref", "scope"],
      "properties": {
        "setting_ref": { "$ref": "#/$defs/settingRef" },
        "scope": { "$ref": "#/$defs/scope" },
        "value": { "description": "absent for reset; MUST be absent for secret-kind settings, which carry secret_reference only" },
        "secret_reference": { "$ref": "#/$defs/secretReference" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op_id", "owner_ref", "setting_ref", "scope", "kind", "status"],
      "properties": {
        "op_id": { "type": "string", "pattern": "^op-[A-Za-z0-9_-]+$" },
        "depends_on": { "type": "array", "items": { "type": "string" }, "description": "real owner-disclosed dependencies only" },
        "owner_ref": { "type": "string", "pattern": "^(connector/)?[a-z0-9][a-z0-9-]*$" },
        "setting_ref": { "$ref": "#/$defs/settingRef" },
        "scope": { "$ref": "#/$defs/scope" },
        "kind": { "enum": ["plan", "validate", "apply", "reset"] },
        "plan_digest": { "description": "sha256 hex over the canonical plan body — the idempotency anchor", "type": ["string", "null"] },
        "plan_ref": { "type": ["string", "null"] },
        "status": { "enum": ["planned", "validated", "applied", "verified", "failed"] },
        "receipt_ref": { "type": ["string", "null"] },
        "error": { "$ref": "#/$defs/operationError" }
      }
    },
    "operationError": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["unsupported_setting", "unsupported_scope", "unknown_scope_kind", "invalid_value", "validation_failed", "owner_unavailable", "plan_expired", "not_authorised", "unsupported_schema", "internal"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "verification": {
      "type": ["object", "null"],
      "required": ["reading_digest", "observed_at_unix_ms", "reconciliations"],
      "properties": {
        "reading_digest": { "type": ["string", "null"], "description": "sha256 over the post-apply v2 reading, 07 §4.5 convention" },
        "observed_at_unix_ms": { "type": "integer", "minimum": 0 },
        "reconciliations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["setting_ref", "status"],
            "properties": {
              "setting_ref": { "$ref": "#/$defs/settingRef" },
              "status": { "enum": ["satisfied", "drifted", "pending", "blocked", "unsupported", "unknown"] }
            }
          }
        }
      }
    },
    "settingRef": {
      "type": "string",
      "pattern": "^(connector/)?[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9_][a-z0-9_-]*(\\.[a-z0-9_][a-z0-9_-]*)*$"
    },
    "scope": {
      "type": "object",
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": { "$ref": "#/$defs/scopeKind" },
        "scope_ref": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "scopeKind": {
      "enum": ["world", "ground", "project", "machine", "workcell", "agency", "agent", "session-space", "agent-session", "provider", "connector-relation", "invocation"]
    },
    "secretReference": {
      "type": ["object", "null"],
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
