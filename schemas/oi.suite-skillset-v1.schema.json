{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epilogos.dev/schemas/oi.suite-skillset-v1.schema.json",
  "title": "O:I suite operator SkillSet composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skills", "profiles"],
  "properties": {
    "schema": { "const": "oi.suite-skillset/v1" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "expected_native_skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectedNativeSkill" }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_ref", "native_owner", "source"],
      "properties": {
        "skill_ref": { "$ref": "#/$defs/ref" },
        "native_owner": { "$ref": "#/$defs/ref" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "path"],
          "properties": {
            "repository": { "$ref": "#/$defs/ref" },
            "revision": { "$ref": "#/$defs/ref" },
            "path": { "$ref": "#/$defs/ref" }
          }
        },
        "required_capability_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "related_action_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "scope", "skill_refs"],
      "properties": {
        "profile_ref": { "$ref": "#/$defs/ref" },
        "scope": { "enum": ["ordinary", "root_world"] },
        "skill_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "expectedNativeSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_owner", "purpose", "profile_refs", "required_when_installed", "state"],
      "properties": {
        "native_owner": { "$ref": "#/$defs/ref" },
        "purpose": { "$ref": "#/$defs/ref" },
        "profile_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "required_when_installed": { "type": "boolean" },
        "state": { "const": "awaiting_native_publication" }
      }
    }
  }
}
