{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o-i.dev/schemas/oi.native-source-contribution-v1.schema.json",
  "title": "O:I compiled native source contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contribution_ref",
    "owner",
    "revision",
    "entry",
    "entry_sha256",
    "surfaces"
  ],
  "properties": {
    "schema": {
      "const": "oi.native-source-contribution/v1"
    },
    "contribution_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+\\.(tsx|ts)$"
    },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_capture": {
      "type": "object",
      "description": "Historical native capture provenance, not code-loading or action authority."
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "descriptor_ref",
          "kind",
          "title",
          "mount_export",
          "retention",
          "region"
        ],
        "properties": {
          "descriptor_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mount_export": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "retention": {
            "const": "mounted"
          },
          "region": {
            "const": "canvas"
          }
        }
      }
    }
  }
}
