{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epilogos.github.io/o-i/schemas/oi.development-impact-v1.schema.json",
  "title": "O:I Development Field impact declaration v1",
  "description": "Cross-product declaration envelope for intended development impact. It names owner refs and proof obligations without replacing owner semantics or claiming human EX.",
  "type": "object",
  "required": ["schema", "plan_refs", "affected_owners", "expected_proof"],
  "properties": {
    "schema": { "const": "oi.development-impact/v1" },
    "plan_refs": { "$ref": "#/$defs/refs" },
    "ux_refs": { "$ref": "#/$defs/refs" },
    "capability_refs": { "$ref": "#/$defs/refs" },
    "source_refs": { "$ref": "#/$defs/refs" },
    "affected_owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["oi", "central", "actuation", "ai-kit", "software-factory", "workcell", "quaternal-logic"]
      }
    },
    "expected_proof": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["D", "C", "P", "M", "H"] }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
