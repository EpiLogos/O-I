{
  "name": "oi-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:spacetimedb": "spacetime generate --lang typescript --out-dir src/explore/spacetimedb-bindings --module-path ../shared-field/spacetimedb",
    "dev": "npm run build:library && npm run generate:spacetimedb && vite",
    "build": "npm run build:library && npm run generate:spacetimedb && tsc -b && vite build",
    "preview": "vite preview",
    "build:essay": "node build-essay-browser.mjs",
    "build:library": "node build-library.mjs && node build-publications.mjs && node build-essay-browser.mjs && node prepare-public-assets.mjs",
    "test:essay": "node --experimental-strip-types --test essay-browser.test.mjs essay-host.test.mjs",
    "dev:public": "npm run build:library && vite --config vite.public.config.ts",
    "build:public": "npm run build:library && tsc -p tsconfig.public.json && vite build --config vite.public.config.ts",
    "test:library": "node --test library.test.mjs publication.test.mjs"
  },
  "dependencies": {
    "@epilogos/oi-design-system": "file:../packages/oi-design-system",
    "@studio-freight/lenis": "^1.0.42",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.8.1",
    "tailwind-merge": "^2.5.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
